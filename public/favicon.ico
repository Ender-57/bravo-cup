<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <!-- Background Circle -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00A3FF"/>
      <stop offset="100%" stop-color="#005B99"/>
    </linearGradient>
    
    <!-- Racket Frame Gradient -->
    <linearGradient id="racketRim" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#E2E8F0"/>
    </linearGradient>

    <linearGradient id="corkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047"/>
      <stop offset="100%" stop-color="#EA580C"/>
    </linearGradient>
  </defs>

  <!-- Circular Base Badge for High Visibility on Dark & Light Browser Tabs -->
  <circle cx="64" cy="64" r="62" fill="url(#bgGrad)" stroke="#FFFFFF" stroke-width="4"/>

  <!-- RACKET -->
  <g transform="rotate(-15 64 64)">
    <!-- Racket Shaft & Handle -->
    <line x1="56" y1="70" x2="26" y2="106" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round"/>
    <line x1="28" y1="104" x2="16" y2="118" stroke="#0F172A" stroke-width="10" stroke-linecap="round"/>
    <!-- Grip wraps -->
    <line x1="26" y1="106" x2="23" y2="110" stroke="#38BDF8" stroke-width="3"/>
    <line x1="21" y1="112" x2="18" y2="116" stroke="#38BDF8" stroke-width="3"/>

    <!-- T-Joint -->
    <circle cx="56" cy="70" r="5" fill="#FFFFFF"/>

    <!-- Racket Head Rim -->
    <ellipse cx="82" cy="40" rx="28" ry="32" fill="#0369A1" fill-opacity="0.4" stroke="url(#racketRim)" stroke-width="7"/>

    <!-- String Grid (Bold, clean lines) -->
    <line x1="68" y1="24" x2="96" y2="56" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
    <line x1="60" y1="36" x2="88" y2="68" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
    <line x1="76" y1="14" x2="104" y2="44" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
    
    <line x1="96" y1="24" x2="68" y2="56" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
    <line x1="88" y1="14" x2="60" y2="44" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
    <line x1="104" y1="36" x2="76" y2="68" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.8"/>
  </g>

  <!-- SHUTTLECOCK (Kok Badminton) -->
  <g transform="translate(34, 22) scale(0.95) rotate(-25)">
    <!-- White Feathers -->
    <polygon points="12,18 28,0 36,8 20,26" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.5"/>
    <polygon points="18,24 34,6 42,14 26,32" fill="#F8FAFC" stroke="#94A3B8" stroke-width="1.5"/>
    <!-- Feather Ribbon -->
    <path d="M22,14 Q30,20 38,12" stroke="#007DCC" stroke-width="2.5" fill="none"/>
    <!-- Cork / Tip -->
    <circle cx="12" cy="28" r="8" fill="url(#corkGrad)" stroke="#B45309" stroke-width="1.5"/>
  </g>
</svg>
